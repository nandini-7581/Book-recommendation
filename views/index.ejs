<%
    const groups = [
        books.slice(0, 5),
        books.slice(5, 10),
        books.slice(10, 15),
        books.slice(15, 20)
    ];
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="d-flex flex-column flex-md-row p-4 gap-4 py-md-5 align-items-center justify-content-center">
        <div class="list-group list-group-checkable d-grid gap-2 border-0">

            <% groups.forEach((group, groupIndex) => { %>
                <input
                    class="list-group-item-check pe-none"
                    type="radio"
                    name="bookGroup"
                    id="bookGroup<%= groupIndex %>"
                    <%= groupIndex === 0 ? "checked" : "" %>
                >

                <label class="list-group-item rounded-3 py-3" for="bookGroup<%= groupIndex %>">
                    <% group.forEach(book => { %>
                        <div>
                            <%= book.volumeInfo?.title || "Untitled" %>
                        </div>
                    <% }) %>

                    <span class="d-block small opacity-50">
                        Books in group <%= groupIndex + 1 %>
                    </span>
                </label>
            <% }) %>

        </div>
    </div>
</body>
</html>